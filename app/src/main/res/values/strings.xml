    <string name="trash_title">Trash</string>
    <string name="trash_row_subtitle">Deleted photos and videos</string>
    <string name="trash_info">Android keeps trashed items for about 30 days, then deletes them automatically. Restore puts a file back where it was; Android confirms each restore or delete.</string>
    <string name="trash_unsupported_title">Trash needs Android 11</string>
    <string name="trash_unsupported_message">On Android 10 and below, Gallery can\'t move items to Trash or delete them from inside the app.</string>
    <string name="trash_empty_title">Trash is empty</string>
    <string name="trash_empty_message">Items you delete from the viewer wait here for about 30 days. Gallery only lists what Android lets it see.</string>
